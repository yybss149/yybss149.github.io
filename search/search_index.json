{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"\u6211\u7684\u7f51\u7ad9\u540d\u79f0 <p>\u6b22\u8fce\u6765\u5230\u6211\u7684\u4e2a\u4eba\u7f51\u7ad9</p>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6211\u662f \u4f60\u7684\u540d\u5b57\u3002</p> <p>\u8fd9\u662f\u6211\u7684\u4e2a\u4eba\u7f51\u7ad9\u3002\u6211\u4f1a\u5728\u8fd9\u91cc\u8bb0\u5f55\u5b66\u4e60\u7b14\u8bb0\u3001\u5206\u4eab\u8bfe\u7a0b\u5185\u5bb9\uff0c\u4e5f\u4f1a\u6536\u85cf\u559c\u6b22\u7684\u7f51\u7ad9\u3002</p> <p>\u4f60\u53ef\u4ee5\u628a\u8fd9\u6bb5\u6587\u5b57\u66ff\u6362\u6210\u81ea\u5df1\u7684\u4ecb\u7ecd\uff0c\u4f8b\u5982\uff1a\u4f60\u7684\u804c\u4e1a\u3001\u5174\u8da3\u3001\u6b63\u5728\u505a\u7684\u4e8b\uff0c\u4ee5\u53ca\u5e0c\u671b\u8bfb\u8005\u5982\u4f55\u8054\u7cfb\u4f60\u3002</p>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u6211\u6b63\u5728\u5b66\u4e60\u3001\u6574\u7406\u548c\u5206\u4eab\u7684\u5185\u5bb9\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u5199\u4e00\u7bc7\u8bfe\u7a0b\u6587\u7ae0</li> </ul> <p>\u4ee5\u540e\u65b0\u589e\u6587\u7ae0\u65f6\uff0c\u5728\u8fd9\u4e2a\u5217\u8868\u4e2d\u52a0\u4e0a\u4e00\u6761\u94fe\u63a5\u5373\u53ef\u3002</p>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u5199\u4e00\u7bc7\u8bfe\u7a0b\u6587\u7ae0","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u6587\u6863\u3002\u590d\u5236\u5b83\u5e76\u6539\u540d\uff0c\u5c31\u53ef\u4ee5\u5f00\u59cb\u5199\u4f60\u7684\u4e0b\u4e00\u7bc7\u8bfe\u7a0b\u6587\u7ae0\u3002</p>"},{"location":"course/example/#_2","title":"\u8fd9\u7bc7\u6587\u7ae0\u8981\u8bb2\u4ec0\u4e48\uff1f","text":"<p>\u7528\u4e24\u4e09\u53e5\u8bdd\u8bf4\u660e\u4e3b\u9898\u3001\u9002\u5408\u8c01\u9605\u8bfb\uff0c\u4ee5\u53ca\u8bfb\u5b8c\u80fd\u5b66\u5230\u4ec0\u4e48\u3002</p>"},{"location":"course/example/#_3","title":"\u51c6\u5907\u5185\u5bb9","text":"<ul> <li>\u7b2c\u4e00\u4e2a\u9700\u8981\u77e5\u9053\u7684\u6982\u5ff5\u6216\u5de5\u5177</li> <li>\u7b2c\u4e8c\u4e2a\u9700\u8981\u51c6\u5907\u7684\u6750\u6599</li> </ul>"},{"location":"course/example/#_4","title":"\u6b63\u6587\u6b65\u9aa4","text":""},{"location":"course/example/#_5","title":"\u7b2c\u4e00\u6b65\uff1a\u8bf4\u660e\u8981\u505a\u4ec0\u4e48","text":"<p>\u7528\u7b80\u5355\u7684\u8bed\u8a00\u63cf\u8ff0\u64cd\u4f5c\uff0c\u5e76\u914d\u4e0a\u5fc5\u8981\u7684\u56fe\u7247\u3001\u4ee3\u7801\u6216\u94fe\u63a5\u3002</p>"},{"location":"course/example/#_6","title":"\u7b2c\u4e8c\u6b65\uff1a\u7ee7\u7eed\u5b8c\u6210","text":"<p>\u628a\u8fc7\u7a0b\u62c6\u6210\u5c0f\u6b65\u9aa4\uff0c\u6bcf\u4e00\u6b65\u53ea\u8bb2\u4e00\u4ef6\u4e8b\u3002</p>"},{"location":"course/example/#_7","title":"\u5c0f\u7ed3","text":"<p>\u603b\u7ed3\u5173\u952e\u8981\u70b9\uff0c\u4e5f\u53ef\u4ee5\u5199\u4e0b\u4e0b\u4e00\u6b65\u5efa\u8bae\u3002</p> <p>\u5199\u65b0\u6587\u7ae0\u7684\u65b9\u6cd5\uff1a \u5728 <code>docs/course</code> \u6587\u4ef6\u5939\u4e2d\u590d\u5236\u672c\u6587\u4ef6\uff0c\u6362\u4e00\u4e2a\u82f1\u6587\u6587\u4ef6\u540d\uff08\u4f8b\u5982 <code>my-note.md</code>\uff09\uff0c\u7136\u540e\u56de\u5230\u201c\u8bfe\u7a0b\u201d\u9996\u9875\u628a\u5b83\u52a0\u5165\u6587\u7ae0\u5217\u8868\u3002</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u4f1a\u653e\u6211\u63a8\u8350\u7684\u670b\u53cb\u7f51\u7ad9\u548c\u6709\u610f\u601d\u7684\u9879\u76ee\u3002</p> <ul> <li>\u793a\u4f8b\u94fe\u63a5\u4e00</li> <li>\u793a\u4f8b\u94fe\u63a5\u4e8c</li> </ul> <p>\u4ee5\u540e\u53ef\u4ee5\u628a\u94fe\u63a5\u6587\u5b57\u548c\u7f51\u5740\u66ff\u6362\u6210\u4f60\u81ea\u5df1\u7684\u53cb\u94fe\u3002</p>"}]}